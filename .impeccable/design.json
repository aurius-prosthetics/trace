  "narrative": {
    "northStar": "The Kakeibo Notebook",
    "overview": "Trace is the screen version of a Japanese household-budget notebook: a graph-paper page you fill in, ruled in ink, with the month tallied by week. Content lives on white pages with 1px ink rules and small corners; no soft shadows.",
    "keyCharacteristics": [
      "Graph-paper ground with white pages and ink-colored hairlines.",
      "Ledger Sage is the only accent; green, red and amber are semantic.",
      "Summary strip plus week tally replaces the three-tile hero metrics.",
      "Square-ish corners (4-6px); depth only for sheets and the FAB.",
      "Tabular numerals; system sans throughout; serif only for the wordmark."
    ],
    "rules": [
      {
        "name": "The One Ink Rule",
        "body": "Ledger Sage is the only brand accent.",
        "section": "colors"
      },
      {
        "name": "The Variable Rule",
        "body": "No hex in component CSS or charts; read variables at render time.",
        "section": "colors"
      },
      {
        "name": "The Tabular Rule",
        "body": "Amounts use font-variant-numeric: tabular-nums.",
        "section": "typography"
      },
      {
        "name": "The One Serif Rule",
        "body": "Cormorant appears only in the wordmark.",
        "section": "typography"
      },
      {
        "name": "The Ink-Not-Shadow Rule",
        "body": "If it doesn't float over content, it gets a rule, not a shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use variables for every color in both themes.",
      "Do keep money in tabular numerals and rows square so they stack.",
      "Do show state by form as well as color (tally marks, struck rows), not color alone."
    ],
    "donts": [
      "Don't reintroduce three separate hero-metric tiles or soft-shadow rounded cards.",
      "Don't add a second accent or use red, green or amber decoratively.",
      "Don't use emoji as UI icons or the serif outside the wordmark.",
      "Don't hardcode hex in new CSS."
    ]
  }
