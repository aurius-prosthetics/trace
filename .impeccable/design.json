  "narrative": {
    "northStar": "The Private Ledger",
    "overview": "Trace looks like a personal account book kept by someone careful: quiet paper-toned surfaces, hairline rules, figures aligned in tabular columns, and a single muted green used the way a ledger uses ink. Nothing performs. The interface stays out of the way of a task that happens in seconds, usually on a phone with one thumb.",
    "keyCharacteristics": ["Flat, hairline-bordered surfaces; depth only for things that float.", "One accent (Ledger Sage); semantic green, red and amber appear only to mean something.", "Money in heavy, tight, tabular numerals.", "System sans for the whole app; one serif moment, the wordmark.", "Every color is a CSS variable with a dark-mode override."],
    "rules": [
      { "name": "The One Ink Rule", "body": "Ledger Sage is the only brand accent. Green, red and amber are semantic and never decorate.", "section": "colors" },
      { "name": "The Variable Rule", "body": "No hex in component CSS or chart configs. Read variables at render time so both themes work.", "section": "colors" },
      { "name": "The Tabular Rule", "body": "Every amount uses font-variant-numeric: tabular-nums so columns of money align.", "section": "typography" },
